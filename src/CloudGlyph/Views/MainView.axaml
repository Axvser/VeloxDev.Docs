<UserControl xmlns="https://github.com/avaloniaui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:vm="using:CloudGlyph.ViewModels"
			 xmlns:models="using:CloudGlyph.Models"
			 xmlns:services="using:CloudGlyph.Services"
			 xmlns:md="clr-namespace:AvalonMarkdown.Views;assembly=AvalonMarkdown"
			 mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
			 x:Class="CloudGlyph.Views.MainView"
			 x:DataType="vm:MainViewModel"
			 Background="{DynamicResource Window}">

	<Design.DataContext>
		<vm:MainViewModel />
	</Design.DataContext>

	<Grid RowDefinitions="Auto,*,Auto">

		<!-- 标题栏。三列 `*,Auto,*`：两侧星号列等宽，因此中间那列恰好落在窗口正中，
			 搜索框不随左右两侧内容宽度变化而偏移。 -->
		<Border Grid.Row="0"
				Height="68"
				Background="{DynamicResource Surface}"
				BorderBrush="{DynamicResource Border}"
				BorderThickness="0,0,0,1"
				Padding="22,10">
			<Grid ColumnDefinitions="*,Auto,*">

				<!-- 左：文档标题 + 副标题 -->
				<StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
					<TextBlock Text="{Binding Document.Title}"
							   Classes="heading"
							   TextTrimming="CharacterEllipsis" />
					<TextBlock Text="{Binding Document.Subtitle}"
							   Classes="caption"
							   TextTrimming="CharacterEllipsis" />
				</StackPanel>

				<!-- 中：搜索框（Ctrl+K 聚焦，Esc 清空） -->
				<TextBox Grid.Column="1"
						 x:Name="SearchBox"
						 Width="440"
						 Height="32"
						 VerticalAlignment="Center"
						 PlaceholderText="Search pages…  (Ctrl+K)"
						 Text="{Binding Document.Query, Mode=TwoWay}">
					<TextBox.KeyBindings>
						<KeyBinding Gesture="Escape" Command="{Binding Document.ClearQueryCommand}" />
					</TextBox.KeyBindings>
					<TextBox.InnerRightContent>
						<Button Padding="6,2"
								Background="Transparent"
								BorderThickness="0"
								Content="✕"
								Foreground="{DynamicResource Muted}"
								ToolTip.Tip="Clear search"
								IsVisible="{Binding Document.ShowResults}"
								Command="{Binding Document.ClearQueryCommand}" />
					</TextBox.InnerRightContent>
				</TextBox>

			</Grid>
		</Border>

		<Grid Grid.Row="1" x:Name="WorkspaceGrid">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="280" MinWidth="200" MaxWidth="520" />
				<ColumnDefinition Width="8" />
				<ColumnDefinition Width="*" MinWidth="360" />
			</Grid.ColumnDefinitions>

			<!-- 左侧目录树。搜索不再挤掉它：结果浮在内容之上，导航树始终在位。 -->
			<Border Grid.Column="0"
					Background="{DynamicResource Surface}"
					BorderBrush="{DynamicResource Border}"
					BorderThickness="0,0,1,0">
				<DockPanel LastChildFill="True">
					<StackPanel DockPanel.Dock="Top" Margin="16,14,16,8" Spacing="8">
						<TextBlock Text="Navigation"
								   Foreground="{DynamicResource Accent}"
								   FontSize="11"
								   FontWeight="SemiBold" />
						<!-- 语言选择器放在侧栏而不是顶栏：下拉是 Avalonia 画布内容，而 Markdown 预览是
							 盖在画布上的 DOM iframe（NativeControlHost）。顶栏右侧展开时会落进 iframe
							 的矩形里被遮住；在侧栏宽度内展开则始终可见。 -->
						<ComboBox ItemsSource="{Binding Document.TopLanguages}"
								  SelectedItem="{Binding Document.SelectedLanguage}"
								  ToolTip.Tip="Document language"
								  HorizontalAlignment="Stretch">
							<ComboBox.ItemTemplate>
								<DataTemplate x:DataType="vm:LanguageOption">
									<TextBlock Text="{Binding DisplayName}" />
								</DataTemplate>
							</ComboBox.ItemTemplate>
						</ComboBox>
					</StackPanel>
					<TreeView ItemsSource="{Binding Document.Nodes}"
							  SelectedItem="{Binding Document.SelectedNode}"
							  Margin="8,0,8,8"
							  Background="Transparent">
						<TreeView.Styles>
							<!-- 展开状态存在 PageNode 上，视图模型才能替跳转到的页面打开其祖先分支。
								 这里用 ReflectionBinding 而非编译绑定：Style 没有可供绑定编译器推断的
								 DataContext 类型。 -->
							<Style Selector="TreeViewItem">
								<Setter Property="Foreground" Value="{DynamicResource Text}" />
								<Setter Property="IsExpanded"
										Value="{ReflectionBinding IsExpanded, Mode=TwoWay}" />
							</Style>
						</TreeView.Styles>
						<TreeView.ItemTemplate>
							<TreeDataTemplate ItemsSource="{Binding Children}"
											  x:DataType="models:PageNode">
								<TextBlock Text="{Binding Title}"
										   x:DataType="models:PageNode" />
							</TreeDataTemplate>
						</TreeView.ItemTemplate>
					</TreeView>
				</DockPanel>
			</Border>

			<!-- 自绘分隔条：按指针的绝对位置写左侧列宽，不在拖动中回读取整后的 ActualWidth
				 （GridSplitter 在 150% 缩放下会因此来回跳 1px）。右侧仍是星号列，窗口缩放继续铺满。 -->
			<Border Grid.Column="1"
					x:Name="PaneSplitter"
					Width="8"
					Background="{DynamicResource Surface}"
					Cursor="SizeWestEast"
					PointerPressed="OnPaneSplitterPointerPressed"
					PointerMoved="OnPaneSplitterPointerMoved"
					PointerReleased="OnPaneSplitterPointerReleased"
					PointerCaptureLost="OnPaneSplitterPointerCaptureLost" />

			<!-- 右侧 Markdown 内容：铺满剩余区域，不内缩、不描边。 -->
			<Border Grid.Column="2"
					Background="{DynamicResource Surface}">
				<Grid Background="Transparent">
					<TextBlock Text="Loading..."
							   IsVisible="{Binding Document.IsLoading}"
							   HorizontalAlignment="Center"
							   VerticalAlignment="Center"
							   Foreground="{DynamicResource Muted}"
							   FontSize="13" />
					<md:MarkdownView x:Name="MarkdownPreview"
									 Text="{Binding Document.Content}"
									 HorizontalAlignment="Stretch"
									 VerticalAlignment="Stretch"
									 Background="Transparent" />
				</Grid>
			</Border>

		</Grid>

		<!-- 状态栏 -->
		<Border Grid.Row="2"
				Background="{DynamicResource Surface}"
				BorderBrush="{DynamicResource Border}"
				BorderThickness="0,1,0,0"
				Padding="22,5">
			<TextBlock Text="{Binding Document.StatusText}"
					   Classes="caption" />
		</Border>

		<!-- 搜索结果：从搜索框正下方浮出的面板。
			 用 Popup 而不是普通 Border —— Markdown 预览是 NativeWebView（HWND 子窗口），
			 Avalonia 自己的内容画不到它上面（airspace 限制），而 Popup 是独立窗口，可以。

			 宽度与搜索框严格相同（440），水平偏移为 0。这是刻意的：Popup 的贴靠边由
			 PlacementMode 决定，宽度一旦不同，就只能对齐其中一条边、另一条必然参差。
			 等宽 + 零偏移则无论贴哪条边，四条边都重合。

			 面板底色直接取 Surface：应用整体走 Avalonia 的 ThemeVariant + ThemeDictionaries，
			 这里用 DynamicResource 就会随系统明暗同步切换。 -->
		<Popup x:Name="ResultsPopup"
			   IsOpen="{Binding Document.IsSearchOpen, Mode=TwoWay}"
			   PlacementTarget="{Binding #SearchBox}"
			   Placement="Bottom"
			   HorizontalOffset="0"
			   VerticalOffset="4"
			   IsLightDismissEnabled="True">
			<Border Width="440"
					MaxHeight="440"
					CornerRadius="8"
					BorderThickness="1"
					BorderBrush="{DynamicResource Border}"
					Background="{DynamicResource Surface}"
					BoxShadow="0 10 28 0 #55000000">
				<Grid RowDefinitions="Auto,Auto,*">

					<TextBlock Grid.Row="0"
							   Text="{Binding Document.ResultsHeader}"
							   Margin="12,8,12,4"
							   Foreground="{DynamicResource Muted}"
							   FontSize="11" />

					<TextBlock Grid.Row="1"
							   Text="Building index…"
							   IsVisible="{Binding Document.IsIndexing}"
							   Margin="12,0,12,6"
							   Foreground="{DynamicResource Muted}"
							   FontSize="11" />

					<ListBox Grid.Row="2"
							 ItemsSource="{Binding Document.Results}"
							 SelectedItem="{Binding Document.SelectedResult}"
							 Margin="4,0,4,4"
							 Background="Transparent">
						<ListBox.ItemTemplate>
							<DataTemplate x:DataType="services:SearchHit">
								<StackPanel Margin="0,2">
									<TextBlock Text="{Binding Title}"
											   Foreground="{DynamicResource Text}"
											   FontWeight="SemiBold"
											   TextTrimming="CharacterEllipsis" />
									<TextBlock Text="{Binding Snippet}"
											   Foreground="{DynamicResource Muted}"
											   FontSize="11"
											   MaxLines="2"
											   TextWrapping="Wrap" />
								</StackPanel>
							</DataTemplate>
						</ListBox.ItemTemplate>
					</ListBox>
				</Grid>
			</Border>
		</Popup>
	</Grid>
</UserControl>
