<Project Sdk="Microsoft.NET.Sdk.WebAssembly">
  <PropertyGroup>
    <TargetFramework>net10.0-browser</TargetFramework>
    <OutputType>Exe</OutputType>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
	<PublishTrimmed>false</PublishTrimmed>
    <!-- Set here, not by a package: the workload's manifest is evaluated before package targets,
         and WasmBuildNative is one of the switches that loads the native linking targets. -->
    <WasmBuildNative>true</WasmBuildNative>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Browser" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CloudGlyph\CloudGlyph.csproj" />
  </ItemGroup>

  <!--
    A publish whose SDK cannot see the wasm-tools workload skips native linking without failing:
    dotnet.native.wasm stays at the runtime pack's ~3 MB and libSkiaSharp never gets linked, so the
    site dies at startup with DllNotFoundException. Refuse to produce such a bundle.
  -->
  <Target Name="_RequireWasmNativeLinking" BeforeTargets="Build"
          Condition="'$(RuntimeIdentifier)' == 'browser-wasm'">
    <Error Condition="'@(NativeFileReference->Count())' == '0'"
           Text="NativeFileReference is empty; libSkiaSharp would not be linked into dotnet.native.wasm." />
  </Target>
</Project>
